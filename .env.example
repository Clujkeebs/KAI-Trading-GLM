# === REQUIRED ===

# OpenRouter API Key (GLM 5.2 lives here)
# 1. Go to https://openrouter.ai  (English, US-based)
# 2. Sign up with Google/GitHub
# 3. Add credits ($5 lasts a LONG time for this bot)
# 4. Keys > Create Key > paste below
AI_API_KEY=

# === OPTIONAL ===

# AI provider: "openrouter" (default, recommended), "groq", "openai", "together"
# openrouter = GLM 5.2 (z-ai/glm-5.2) - the model you asked for
AI_PROVIDER=openrouter

# AI model name
# Default: z-ai/glm-5.2  (GLM 5.2 - the exact model powering this chat)
# Other options on OpenRouter: z-ai/glm-4.7, z-ai/glm-4.5-air:free (free tier!)
AI_MODEL=z-ai/glm-5.2

# Maximum completion tokens for AI responses (default: 4000)
# Reasoning models spend this budget on thinking BEFORE emitting any content, so a
# small value silently truncates every decision into an unparseable fragment. The
# bot doubles this automatically (up to 16000) if it sees a truncated reply.
AI_MAX_TOKENS=4000

# How hard the model is allowed to think: off | low | medium | high (default: low)
# Lower effort leaves more of the budget for the JSON that carries the decision.
# Providers that reject the parameter are detected and retried without it.
AI_REASONING_EFFORT=low

# Model to fall back to if AI_MODEL is rejected as unknown (blank = none).
# A mistyped or retired model id otherwise fails every call while the bot looks
# healthy, answering HOLD to everything. Set this to a model you know works
# before experimenting with AI_MODEL.
AI_MODEL_FALLBACK=

# Optional OpenAI-compatible API base URL; blank uses the provider map above
AI_BASE_URL=

# Optional trading charter path; blank uses SOUL.md at the repository root
SOUL_FILE=

# Optional trading playbook path; blank uses PLAYBOOK.md at the repository root
PLAYBOOK_FILE=

# Kraken API Keys (required; paper mode still uses Kraken market data)
# Get from Kraken > Settings > API > Create Key
# Permissions: Trade ONLY (not Withdraw)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Paper mode: true = fake trades, false = REAL MONEY (default: live)
PAPER_MODE=false

# Portfolio value in USD (only used as fallback if API balance fails)
PORTFOLIO_VALUE=200

# Scan interval in minutes
SCAN_INTERVAL_MINUTES=30

# Continuous worker mode (default: true); set false or use --once for one cycle
LOOP_MODE=true

# Maximum affordable new-buy AI decisions per cycle (default: 6)
AI_DECISIONS_PER_CYCLE=6

# Scan universe: exchange-discovered active USD spot markets, or the legacy watchlist
SCAN_UNIVERSE=auto

# Minimum 24-hour quote volume for Stage 1 scan candidates (default: $250,000)
MIN_24H_QUOTE_VOLUME_USD=250000

# Maximum markets receiving full OHLCV/TA analysis after ticker ranking
SCAN_TA_LIMIT=40

# Liquid daily gainers and losers forced into Stage 2 (default: 3 each)
DAILY_MOVERS_COUNT=3

# Quietest liquid markets forced into full TA every cycle (default: 3, 0 disables)
# The coarse rank and the movers list both structurally miss a market that is
# simply quiet — normal volume, unremarkable 24h range, nobody's attention on it.
# That is the profile of something basing before the rest of the market notices
# it. This is what finds that, rather than only ever seeing what already moved.
SLEEPER_COUNT=3

# Use OpenRouter :online news checks for liquid daily losers (default: true)
AI_WEB_SEARCH=true

# Maximum Phase 1 AI position reviews per cycle (default: 5); blank reviews all
AI_REVIEWS_PER_CYCLE=5

# Maximum age of a saved portfolio stance in cycles; blank disables expiry (default: 4)
STANCE_MAX_AGE_CYCLES=

# Optional bot-side limits. Blank/omitted means disabled.
# Fractions are decimal portfolio shares: 0.85 = 85%, 0.02 = 2%.
MAX_EXPOSURE_PCT=
MAX_RISK_PER_TRADE_PCT=
MAX_PORTFOLIO_RISK_PCT=
MIN_TRADE_USD=
MIN_RR_RATIO=
AI_CONFIDENCE_THRESHOLD=
AI_SELL_CONFIDENCE_THRESHOLD=
SCAN_MAX_RSI=

# Cash reserved for exchange fees on buys (default: 0.01 = 1%)
FEE_RESERVE_PCT=0.01

# === RISK MODEL (active by default) ===
# Stops and targets are sized from ATR (average true range), so a volatile pair
# gets a wider stop than a quiet one instead of a flat percentage.

# Stop distance in ATR multiples (default: 2)
ATR_STOP_MULT=2
# Target distance in ATR multiples (default: 4, i.e. a 2:1 baseline)
ATR_TARGET_MULT=4
# Hard cap on stop distance as a fraction of entry price (default: 0.15 = 15%)
MAX_STOP_DISTANCE_PCT=0.15
# Trail the stop this many ATR below the highest price seen (default: 2.5, 0 disables)
TRAILING_STOP_ATR_MULT=2.5
# Move the stop to breakeven once the trade is up this many R (default: 1, 0 disables)
# The trail stays parked until this point, so the entry stop is never overridden.
BREAKEVEN_AT_R=1

# Lift positions that have fallen under Kraken's minimum sellable size back over
# it, so their stop losses can actually execute (default: true). A holding too
# small to sell reports a stop that would be rejected the moment it triggered.
TOPUP_STRANDED_POSITIONS=true
# Largest such repair, as a share of tradable portfolio value (default: 0.05).
# Past this the position is reported instead of bought, since restoring an exit is
# defensive but buying a much larger position is not.
TOPUP_MAX_PCT=0.05

# Preferred number of concurrent positions (blank = no preference).
# GUIDANCE, NOT A CAP: the model is told the preference and what a full-size
# position looks like at that concentration, and may still spread wider or
# concentrate further if it has a reason. Spreading a small account thin loses a
# disproportionate share to fees and exchange minimums, and leaves no winner big
# enough to matter — but concentration also raises variance, so fewer names means
# a bad one hurts more.
TARGET_POSITION_COUNT=

# Assets the bot must NEVER buy, sell, or manage, comma separated (e.g. SOL,AVAX).
# A hard boundary, not guidance: reserved holdings are removed from the scan, are
# never adopted as positions, are refused at the order layer, and are not counted
# as capital the bot may deploy. Kraken staking names resolve to the underlying
# asset, so SOL covers SOL03.S and AVAX covers AVAX.B — being staked is not
# protection on its own, since unstaking would otherwise hand them to the bot.
EXCLUDED_ASSETS=

# === OPTIONAL SAFETY LIMITS (blank = disabled) ===
# Backstops, not a leash. The model decides how many positions to hold and how
# aggressive to be; these only bound the worst case.
# Stop opening new positions once realised losses today reach this portfolio share
MAX_DAILY_LOSS_PCT=
# Hard ceiling on simultaneously open positions
MAX_OPEN_POSITIONS=
# Cap exposure to any single sector as a portfolio fraction
MAX_SECTOR_EXPOSURE_PCT=

# === POSITION SIZE & ALERTS ===
# Hard floor for opening a NEW position, in USD. Left blank by design: the model
# is *told* that tiny positions are not worth holding (see TARGET_POSITION_COUNT)
# and sizes accordingly, rather than being fenced in. Set it only if you want a
# gate rather than guidance. Existing holdings below it are still imported and
# managed either way.
MIN_TRADE_USD=

# Drawdown, in R, at which a position wakes the model for a decision (default 0.5).
# Reaching it does NOT sell: it forces a review so the model can ask *why* price
# is down and answer sell, hold, or add. The hard stop still sits underneath and
# still sells. Set 0 to disable alerts and rely on the stop alone.
ALERT_AT_R=0.5

# Whether the model may add to an open position when reviewing it (default true).
ALLOW_AI_ADD_ONS=true

# Closest a stop may sit to entry, as a fraction (default 0.005 = 0.5%).
# Risk-based size caps divide by this distance, so a stop a hair below entry
# would silently make them unbounded.
MIN_STOP_DISTANCE_PCT=0.005

# === PREFLIGHT ===
# Before the first cycle the bot verifies itself against the real Kraken account
# and the real model: market coverage, candle freshness, balance parsing, whether
# open positions can actually be sold, and whether the AI returns usable JSON.
# Run it standalone with: npm run doctor
PREFLIGHT=true
# Live AI probe requests during preflight (default: 2; 0 skips the AI check)
PREFLIGHT_AI_SAMPLES=2

# === DASHBOARD ===
# A read-only web view of the live account plus a text box to message the model
# (it reads unread messages on its next portfolio review and may reply, ask for
# funds, or suggest a change to SOUL.md — never applied automatically, only
# shown). It cannot place an order, change a stop, or touch config: the trading
# loop is the only thing that trades.
#
# Blank = disabled. Set a password to turn it on; there is no unauthenticated
# mode, since it serves real portfolio value. Basic Auth over HTTP — Railway
# terminates TLS for the public domain, so this is not sent in the clear.
DASHBOARD_PASSWORD=
DASHBOARD_USERNAME=operator
# Port to listen on. Railway sets $PORT automatically; leave this blank there.
PORT=8080

# === OPERATIONS ===
# Parallel market-data requests per cycle (default: 4; ccxt still rate-limits)
OHLCV_CONCURRENCY=4
# Where positions, state and trade history are stored. Point this at a mounted
# volume on ephemeral hosts (Railway) so state survives a redeploy.
DATA_DIR=

# AI requests sizing. Kraken amount/cost/precision limits and free cash always apply.
