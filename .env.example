# === REQUIRED ===

# OpenRouter API Key (GLM 5.2 lives here)
# 1. Go to https://openrouter.ai  (English, US-based)
# 2. Sign up with Google/GitHub
# 3. Add credits ($5 lasts a LONG time for this bot)
# 4. Keys > Create Key > paste below
AI_API_KEY=

# === OPTIONAL ===

# AI provider: "openrouter" (default, recommended), "groq", "openai", "together"
# openrouter = GLM 5.2 (z-ai/glm-5.2) - the model you asked for
AI_PROVIDER=openrouter

# AI model name
# Default: z-ai/glm-5.2  (GLM 5.2 - the exact model powering this chat)
# Other options on OpenRouter: z-ai/glm-4.7, z-ai/glm-4.5-air:free (free tier!)
AI_MODEL=z-ai/glm-5.2

# Kraken API Keys (only needed for LIVE trading)
# Get from Kraken > Settings > API > Create Key
# Permissions: Trade ONLY (not Withdraw)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Paper mode: true = fake trades (safe testing), false = REAL MONEY
PAPER_MODE=true

# Portfolio value in USD
PORTFOLIO_VALUE=200

# Scan interval in minutes
SCAN_INTERVAL_MINUTES=30
